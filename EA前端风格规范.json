  "formatContract": {
    "standard": "自描述JSON风格契约，不声称是官方DTCG格式，也不是可直接加载的CSS文件。",
    "tokens": "扁平字典，值均为CSS字符串。",
    "references": "{token.id}表示tokens中的同名键；递归替换字符串内所有引用，遇到未知键或循环必须报错。",
    "css": "CSS属性使用kebab-case；尺寸带单位。结构性计数与视口尺寸使用JSON数字，单位为CSS px。",
    "components": "base为容器样式，parts为具名子元素样式，states为状态选择器到CSS样式的映射。消费方负责绑定DOM结构与语义属性。",
    "variants": "buttonVariants、semanticStyles等覆盖集应用在基础组件之后。",
    "cssVariableExport": "可将token键中的点替换为连字符并增加--ea-前缀，例如color.primary导出为--ea-color-primary。",
    "normalization": "数值来自实际页面；为跨框架复用做了组合归纳，不表示所有旧页面完全一致。recommended段落为移植建议。"
  },
  "identity": {
    "classification": "浅色、高信息密度、蓝色主导的企业级工程工作台",
    "keywords": ["克制", "清晰", "紧凑", "可扫描", "轻量科技感", "信息优先"],
    "principles": [
      "浅灰白画布上放置白色细边框卡片，通过间距和对齐区分模块。",
      "蓝色用于普通主操作、选中态、链接和焦点；新紫色用法限定于AI辅助。",
      "卡片不铺大面积饱和色，优先级用细色条、状态用小面积浅底标签。",
      "标题深色，正文灰蓝，编号与时间退后；编号等宽，指标数字对齐。",
      "复杂设置渐进展开；相关字段相邻；长表单保留底部操作。",
      "渐变仅用于局部品牌标识、主按钮或AI区域，不做霓虹与大面积玻璃效果。"
    ]
  },
